#: src/kcm/facets_config.ui:17
msgid "Style:"
msgstr "スタイル:"

#: src/kcm/facets_config.ui:31
msgid "Cube"
msgstr "キューブ"

#: src/kcm/facets_config.ui:36
msgid "Flip"
msgstr "フリップ"

#: src/kcm/facets_config.ui:41
msgid "Deck"
msgstr "デッキ"

#: src/kcm/facets_config.ui:27
msgid "3D transition used when switching virtual desktops"
msgstr "仮想デスクトップを切り替えるときに使う 3D トランジション"

#: src/kcm/facets_config.ui:49
msgid "Duration:"
msgstr "所要時間:"

#: src/kcm/facets_config.ui:59
msgid "Animation length in milliseconds, 0 follows the global animation speed"
msgstr ""
"アニメーションの長さ (ミリ秒)。0 にするとシステム全体のアニメーション速度に従"
"います"

#: src/kcm/facets_config.ui:62
msgid "Automatic"
msgstr "自動"

#: src/kcm/facets_config.ui:65
msgid " ms"
msgstr " ms"

#: src/kcm/facets_config.ui:81
msgid "Zoom out:"
msgstr "ズームアウト:"

#: src/kcm/facets_config.ui:91
msgid "How far the camera pulls back at the middle of the animation"
msgstr "アニメーションの中間でカメラをどれだけ後ろへ引くか"

#: src/kcm/facets_config.ui:94 src/kcm/facets_config.ui:146
msgid " %"
msgstr " %"

#: src/kcm/facets_config.ui:107
msgid "Tilt angle:"
msgstr "傾斜角:"

#: src/kcm/facets_config.ui:117
msgid "Peak tilt of the 3D scene in degrees"
msgstr "3D シーンを傾ける最大の角度 (度)"

#: src/kcm/facets_config.ui:120
msgid "°"
msgstr "°"

#: src/kcm/facets_config.ui:133
msgid "Background dimming:"
msgstr "背景の暗さ:"

#: src/kcm/facets_config.ui:143
msgid "Darkness of the wallpaper shown behind the 3D scene"
msgstr "3D シーンの背後に表示する壁紙の暗さ"

#: src/kcm/facets_config.ui:159
msgid "Apply directional shading to desktop faces during the animation"
msgstr "アニメーション中、デスクトップの面に向きに応じた陰影を付けます"

#: src/kcm/facets_config.ui:162
msgid "Shade faces turned away from the viewer"
msgstr "視点から背を向けた面に陰影を付ける"

#: src/kcm/facets_config.ui:169
msgid ""
"Keep panels and on-screen displays fixed instead of moving them with the "
"desktop"
msgstr ""
"パネルやオンスクリーンディスプレイをデスクトップと一緒に動かさず、固定したま"
"まにします"

#: src/kcm/facets_config.ui:172
msgid "Keep panels and on-screen displays fixed"
msgstr "パネルとオンスクリーンディスプレイを固定する"
